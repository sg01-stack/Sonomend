{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonomend",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/hosted/*"],
  },
  "vars": {
    "SONOMEND_HOSTED_ENABLED": "false",
    "SONOMEND_FREE_TIER_CONFIRMED": "false",
    "SONOMEND_GEMINI_MODEL": "",
  },
}
