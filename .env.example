# Copy to .env for Node, or configure Worker secrets/vars. Never use VITE_ for keys.
SONOMEND_HOSTED_ENABLED=false
SONOMEND_FREE_TIER_CONFIRMED=false
SONOMEND_GEMINI_MODEL=
SONOMEND_GEMINI_KEY=
# Required behind an HTTPS reverse proxy, e.g. https://your-host.example
SONOMEND_PUBLIC_ORIGIN=
HOST=127.0.0.1
PORT=8787
